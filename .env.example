# RECA environment configuration template
# Copy this file to .env for local development.
# Never commit the real .env file.

PROJECT_NAME=RECA
ENVIRONMENT=local
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173
API_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# Replace every <...> value before starting a shared environment.
SECRET_KEY=<replace-with-secure-random-value>
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=<replace-with-secure-password>

# PostgreSQL
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=reca
POSTGRES_USER=reca
POSTGRES_PASSWORD=<replace-with-secure-password>

# MinIO. These values are used only by the internal Compose service in M0-02.
MINIO_ROOT_USER=<replace-with-minio-access-key>
MINIO_ROOT_PASSWORD=<replace-with-minio-secret-key>

# Optional email and observability configuration
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=RECA
SENTRY_DSN=

# Reserved external-service configuration; no M0-01 feature consumes these keys.
MODEL_API_KEY=
OPENALEX_API_KEY=
