# RECA environment configuration template
# Copy this file to .env for local development.
# Never commit the real .env file.

PROJECT_NAME=RECA
ENVIRONMENT=local
DEMO_MODE=false
LOG_LEVEL=INFO
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
API_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
VITE_APP_ENV=local
VITE_DEMO_MODE=false
MAX_UPLOAD_BYTES=50000000
CONNECT_TIMEOUT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=30

# Replace every <...> value before starting a shared environment.
SECRET_KEY=<replace-with-secure-random-value>
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=<replace-with-secure-password>

# PostgreSQL
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=reca
POSTGRES_USER=reca
POSTGRES_PASSWORD=<replace-with-secure-password>

# Core infrastructure. Service URLs are internal Compose defaults; credentials stay placeholders.
VALKEY_URL=valkey://valkey:6379/0
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=<replace-with-minio-access-key>
MINIO_ROOT_PASSWORD=<replace-with-minio-secret-key>
MINIO_BUCKET=reca
GROBID_URL=http://grobid:8070

# M0 worker configuration. Valkey is used only as Celery broker/result backend.
CELERY_BROKER_URL=redis://valkey:6379/0
CELERY_RESULT_BACKEND=redis://valkey:6379/1

# Optional email and observability configuration
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=RECA
SENTRY_DSN=

# Optional external providers. Empty keys mean UNCONFIGURED and do not block the API.
MODEL_BASE_URL=
MODEL_API_KEY=
OPENALEX_API_URL=https://api.openalex.org
OPENALEX_API_KEY=
